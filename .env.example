# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # solo servidor, jamas NEXT_PUBLIC_
# Copiar desde: Project Settings > Database > Connection string > URI (Session pooler, puerto 5432).
# Pegar el string COMPLETO tal cual y reemplazar solo la password, SIN los corchetes.
DATABASE_URL=postgresql://postgres.REF_DEL_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------- Flow (pagos) ----------
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api

# ---------- Brevo (emails) ----------
BREVO_API_KEY=

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
